<div id="filters" class="small">
    <fieldset class="filter-group">
        <legend class="filter-group-legend">
            Record status
            <button
                type="button"
                id="status-popover-trigger"
                class="popover-trigger"
                aria-label="About record statuses"
                aria-expanded={{if this.popoverVisible "true" "false"}}
                aria-haspopup="true"
                {{on "keydown" this.handlePopoverKeydown}}
            >
                <i class="fa-solid fa-question-circle" aria-hidden="true"></i>
            </button>
        </legend>
        <BsPopover
            @triggerElement="#status-popover-trigger"
            @triggerEvents="click"
            @onShown={{this.onPopoverShown}}
            @onHidden={{this.onPopoverHidden}}
            class="popover"
        >Each ROR record has a status of active, inactive or withdrawn. <b>Inactive</b> indicates that an organization has split, merged or otherwise ceased to operate. <b>Withdrawn</b> indicates that an organization was added to ROR in error.</BsPopover>
        <hr>
        <div class="filters-list">
            <input
                class="filters-list-input"
                type="checkbox"
                id="active-status"
                name="activeStatus"
                checked={{this.activeStatus}}
                {{on "change" this.toggleStatus}}
            />
            <label class="filters-list-label" for="active-status">Active</label>
        </div>
        <div class="filters-list">
            <input
                class="filters-list-input"
                type="checkbox"
                id="inactive-status"
                name="inactiveStatus"
                checked={{this.inactiveStatus}}
                {{on "change" this.toggleStatus}}
            />
            <label class="filters-list-label" for="inactive-status">Inactive</label>
        </div>
        <div class="filters-list">
            <input
                class="filters-list-input"
                type="checkbox"
                id="withdrawn-status"
                name="withdrawnStatus"
                checked={{this.withdrawnStatus}}
                {{on "change" this.toggleStatus}}
            />
            <label class="filters-list-label" for="withdrawn-status">Withdrawn</label>
        </div>
    </fieldset>
    <div>
        <button class="btn btn-sm btn-round btn-primary" type="button" id="filter-button" {{on "click" this.applyFilter}}><i class="fa-solid fa-check-circle" aria-hidden="true"></i>Apply</button>
        <button class="btn btn-sm btn-round btn-secondary" type="button" id="clear-button" {{on "click" this.clearFilter}}><i class="fa-solid fa-times-circle" aria-hidden="true"></i>Clear</button>
    </div>
</div>